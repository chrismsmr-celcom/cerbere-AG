# Cerbere AG — configuration self-hosted minimale.
# Générez un vrai .env avec :  ./scripts/selfhost-init.sh
# (les secrets ci-dessous sont remplacés par des valeurs aléatoires)

# ── Obligatoires ───────────────────────────────────────────
POSTGRES_PASSWORD=__GENERATE__
AGENTGUARD_API_KEY=__GENERATE__
AGENTGUARD_ADMIN_SECRET=__GENERATE__
AGENTGUARD_FLASK_SECRET=__GENERATE__

# ── URL par laquelle vos utilisateurs joignent Cerbere ─────
AGENTGUARD_PUBLIC_URL=http://localhost:8080
AGENTGUARD_CORS_ORIGINS=http://localhost:8080

# ── Accès ──────────────────────────────────────────────────
# Mettre true dès que l'accès se fait en HTTPS (reverse proxy devant Cerbere).
AGENTGUARD_COOKIE_SECURE=false
# Nombre de reverse proxies devant Cerbere (1 si Caddy/nginx/Traefik, sinon 0).
AGENTGUARD_TRUSTED_PROXIES=0
# Inscription publique : laisser false sur une instance self-hosted.
AGENTGUARD_SIGNUP_ENABLED=false

# Lien magique par email : mettre true seulement après avoir configuré AGENTGUARD_SMTP_HOST.
AGENTGUARD_MAGIC_LINK_ENABLED=false

# ── SSO d'entreprise OIDC (optionnel) ──────────────────────
# URL de redirection à déclarer chez votre fournisseur : <AGENTGUARD_PUBLIC_URL>/auth/sso/callback
# AGENTGUARD_OIDC_ISSUER=https://acme.okta.com
# AGENTGUARD_OIDC_CLIENT_ID=
# AGENTGUARD_OIDC_CLIENT_SECRET=
# Domaines d'email autorisés (obligatoire ; * = tout email vérifié par le fournisseur)
# AGENTGUARD_OIDC_ALLOWED_DOMAINS=acme.com
# AGENTGUARD_OIDC_DEFAULT_ROLE=viewer
# AGENTGUARD_OIDC_GROUP_ROLE_MAP=cerbere-admins=admin,cerbere-devs=developer,cerbere-auditors=auditor
# AGENTGUARD_OIDC_BUTTON_LABEL=Okta

# ── Licence (optionnel) ────────────────────────────────────
# Sans clé : édition Community, complète et gratuite. Une clé Pro/Team/Enterprise
# ajoute des fonctions (SSO d'entreprise, etc.). Pas de connexion réseau requise.
# AGENTGUARD_LICENSE_KEY=cerbere_lic_v1....

# ── Détection (optionnel) ──────────────────────────────────
# Juge LLM : tout endpoint compatible OpenAI (OpenAI, Azure, DeepSeek, Ollama, vLLM...).
# Pour rester 100 % sur site, pointez vers votre propre serveur.
AGENTGUARD_USE_LLM_JUDGE=false
# AGENTGUARD_JUDGE_URL=http://ollama:11434/v1/chat/completions
# AGENTGUARD_JUDGE_MODEL=llama3.1
# AGENTGUARD_JUDGE_API_KEY=

# Modèle ML local (image plus lourde) : INSTALL_ML=true PRELOAD_MODEL=true docker compose build
AGENTGUARD_USE_ML=false

# ── Alertes (optionnel) ────────────────────────────────────
# AGENTGUARD_ALERT_SLACK_WEBHOOK=
# AGENTGUARD_ALERT_WEBHOOK_URL=
# AGENTGUARD_ALERT_EMAIL_TO=
# AGENTGUARD_SMTP_HOST=
